# ==============================================================================
# Thai VTuber Audience Network (SNA) - Environment Configuration
# Copy this file to .env and configure for your deployment environment.
# DO NOT commit the .env file containing real API keys or secrets to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. YouTube API Configuration (Critical for Production Live Chat & Channel Status)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console (YouTube Data API v3)
YOUTUBE_API_KEY=""

# ------------------------------------------------------------------------------
# 2. Privacy & HMAC Secret (Longitudinal Identity Continuity)
# ------------------------------------------------------------------------------
# Optional: Specify explicit 64-char hex salt. If omitted, loads from config/secret.key.
# Ensure this secret remains permanent across all runs to preserve historical graphs!
VTUBER_SNA_SALT=""

# ------------------------------------------------------------------------------
# 3. Cloud Control Plane / Google Sheets (Optional, falls back to local CSV)
# ------------------------------------------------------------------------------
# Path to Google Service Account JSON key file
GOOGLE_APPLICATION_CREDENTIALS="credentials.json"

# Target Google Spreadsheet ID
VTUBER_SPREADSHEET_ID=""

# ------------------------------------------------------------------------------
# 4. Worker & Scheduler Concurrency Tuning
# ------------------------------------------------------------------------------
# Number of parallel workers (Recommended for 1GB VPS: 3 to 5)
MAX_COLLECTOR_WORKERS=3

# Scheduler type: "greedy" (recommended default: 30x faster) or "pso"
SCHEDULER_TYPE="greedy"

# Collection interval for live streams (minutes)
LIVE_POLL_INTERVAL_MINUTES=5

# Frequency of re-syncing directory listings from Chuysan & Fandom (hours)
DIRECTORY_SYNC_HOURS=24
